<Window x:Class="SBH_SMTP_Checker.SmtpPortInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informationen zu SMTP-Ports" Height="680" Width="760"
        MinHeight="480" MinWidth="600" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F3F3F3">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B1E2D"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#681420" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="SMTP-Ports und Verschlüsselung" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Orientierung für die Auswahl der passenden Servereinstellungen" Foreground="#EECFD4" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Port 25 — Server-zu-Server-Übertragung"/>
                        <TextBlock TextWrapping="Wrap" Text="Port 25 wird traditionell für die SMTP-Kommunikation zwischen Mailservern verwendet und dient hauptsächlich der Übertragung von Nachrichten von Server zu Server. Viele Internet- und Hostinganbieter blockieren ausgehende Clientverbindungen auf diesem Port, um Spam zu verhindern. Für die normale authentifizierte Übermittlung durch Endbenutzer wird Port 25 üblicherweise nicht empfohlen."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Port 465 — SMTP mit implizitem TLS"/>
                        <TextBlock TextWrapping="Wrap" Text="Bei Port 465 wird die verschlüsselte TLS-/SSL-Verbindung unmittelbar beim Verbindungsaufbau hergestellt. Diese Variante wird häufig als SMTPS bezeichnet und wird verwendet, wenn ein Mailanbieter ausdrücklich implizites TLS verlangt."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Port 587 — Standard für SMTP Submission"/>
                        <TextBlock TextWrapping="Wrap" Text="Port 587 ist der Standardport für die authentifizierte Nachrichtenübermittlung durch E-Mail-Programme und Anwendungen. Er ist üblicherweise die empfohlene Wahl zum Senden über einen SMTP-Server. Meist beginnt die Verbindung unverschlüsselt und wird anschließend mit STARTTLS auf TLS umgestellt. Eine Anmeldung ist in der Regel erforderlich."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Port 2525 — Alternativer Submission-Port"/>
                        <TextBlock TextWrapping="Wrap" Text="Einige E-Mail-Anbieter unterstützen Port 2525 als Alternative, wenn beispielsweise 25, 465 oder 587 blockiert sind. Er ist kein offizieller Standardport für SMTP Submission; seine Verfügbarkeit und die erforderliche Verschlüsselung hängen deshalb vom jeweiligen Anbieter ab."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Wichtige Begriffe"/>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="SMTP: "/><Run Text="Protokoll zum Übertragen von E-Mails zwischen Systemen und Mailservern."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"><Run FontWeight="SemiBold" Text="SMTP Submission: "/><Run Text="Annahme ausgehender Nachrichten von authentifizierten Benutzern oder Anwendungen durch einen Mailserver."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"><Run FontWeight="SemiBold" Text="TLS: "/><Run Text="Verfahren zur verschlüsselten und geschützten Übertragung der Verbindung."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"><Run FontWeight="SemiBold" Text="STARTTLS: "/><Run Text="Eine zunächst normale SMTP-Verbindung wird durch einen Protokollbefehl auf TLS-Verschlüsselung umgestellt."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"><Run FontWeight="SemiBold" Text="Implizites TLS: "/><Run Text="Die TLS-Verschlüsselung beginnt sofort beim Aufbau der Verbindung, noch bevor SMTP-Daten ausgetauscht werden."/></TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="#F7ECEE" BorderBrush="#D8AEB5" BorderThickness="1" Padding="14" Margin="0,0,0,2">
                    <TextBlock TextWrapping="Wrap" Foreground="#681420" FontWeight="SemiBold"
                               Text="Wichtig: Der richtige Port und die passende Verschlüsselungsmethode richten sich immer nach den Vorgaben des jeweiligen E-Mail-Anbieters oder Mailserver-Administrators."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Schließen" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</Window>
