<Window x:Class="SEMPT3X_SMTP_CHECKER.ErrorCodesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bekannte Fehlercodes" Height="650" Width="1050" MinHeight="450" MinWidth="760" WindowStartupLocation="CenterOwner" Background="#F3F3F3">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#681420" Padding="16" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Bekannte Fehlercodes" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Standard SMTP and Microsoft 365" Foreground="#EECFD4"/></StackPanel>
            <TextBox Grid.Column="1" x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="10,7" ToolTip="Search code, description, cause, or solution"/>
        </Grid></Border>
        <DataGrid Grid.Row="1" x:Name="ErrorGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kategorie" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="Fehlercode" Binding="{Binding Code}" Width="125"/>
                <DataGridTextColumn Header="Name / Beschreibung" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Mögliche Ursache" Binding="{Binding Cause}" Width="*"/>
                <DataGridTextColumn Header="Mögliche Lösung" Binding="{Binding Solution}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="Tipp: Suchen Sie nach einem erweiterten SMTP-Statuscode, einem AADSTS-Code, einem Graph-Fehlernamen oder einem Symptom." Foreground="#666" Margin="0,10,0,0"/>
    </Grid>
</Window>
