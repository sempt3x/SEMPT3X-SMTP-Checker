<Window x:Class="SEMPT3X_SMTP_CHECKER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEMPT3X SMTP CHECKER" Height="860" Width="1180"
        MinHeight="620" MinWidth="760" WindowStartupLocation="CenterScreen" Background="#F3F3F3"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B1E2D"/><Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,9,0,4"/><Setter Property="Foreground" Value="#444"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#681420" Padding="22,15">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="MAIL SERVER CHECKER" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,28,0"/>
                    <TextBlock Text="Verbindungsart" Foreground="#F5DDE1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ConnectionTypeCombo" Width="280" ItemsSource="{Binding ConnectionTypes}" SelectedIndex="{Binding ConnectionTypeIndex}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Bekannte Fehlercodes" Click="OpenErrors_Click" Background="#A83245" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16,18,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="20">
                    <StackPanel SizeChanged="ConfigurationPanel_SizeChanged">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Konfiguration &amp; Testnachricht"/>
                        <Grid x:Name="SmtpEndpointGrid" Visibility="{Binding IsStandardSmtp, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="SmtpEndpointGap" Width="14"/><ColumnDefinition x:Name="SmtpEndpointSecondColumn"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="SMTP-Serveradresse *"/><TextBox Text="{Binding SmtpServer, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel x:Name="SmtpPortPanel" Grid.Column="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SMTP-Port *"/>
                                    <Button Content="?" Click="OpenSmtpPortHelp_Click" ToolTip="Informationen zu SMTP-Ports"
                                            Width="18" Height="18" Padding="0" Margin="5,9,0,4"
                                            FontSize="11" FontWeight="Bold" Cursor="Hand"
                                            Background="#8B1E2D" Foreground="White"/>
                                </StackPanel>
                                <TextBox Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Visibility="{Binding IsStandardSmtp, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SMTP-Benutzername *"/><TextBox Text="{Binding SmtpUsername, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SMTP-Passwort *"/><PasswordBox x:Name="SmtpPasswordBox"/>
                            <CheckBox Content="TLS / STARTTLS verwenden" IsChecked="{Binding UseTls}" Margin="0,10,0,2"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsMicrosoft365, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Erfordert eine Entra-App-Registrierung mit der Microsoft Graph-Anwendungsberechtigung Mail.Send und der Zustimmung eines Administrators." TextWrapping="Wrap" Foreground="#666" Margin="0,2,0,6"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Mandanten-ID *"/><TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Client-ID *"/><TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Clientschlüssel *"/><PasswordBox x:Name="ClientSecretBox"/>
                        </StackPanel>
                        <Grid x:Name="EmailAddressGrid" Margin="0,4,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="EmailAddressGap" Width="14"/><ColumnDefinition x:Name="EmailAddressSecondColumn"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Absender-E-Mail-Adresse *"/><TextBox Text="{Binding SenderEmail, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel x:Name="RecipientEmailPanel" Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="Empfänger-E-Mail-Adresse *"/><TextBox Text="{Binding RecipientEmail, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Betreff (optional)"/><TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Nachricht / E-Mail-Text"/><TextBox Text="{Binding MessageBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="75" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Anhänge (optional)"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ListBox Height="60" ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment}" ToolTip="Ausgewählte Dateipfade"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><Button Content="Dateien hinzufügen…" Click="AddAttachments_Click" Margin="0,0,0,6"/><Button Content="Entfernen" Command="{Binding RemoveAttachmentCommand}" Background="#666" Margin="0"/></StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Test starten &amp; E-Mail senden" Command="{Binding SendCommand}" MinWidth="190"/>
                            <Button Content="Abbrechen" Command="{Binding CancelCommand}" Background="#666"/>
                        </StackPanel>
                    </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="20">
                <StackPanel><TextBlock Style="{StaticResource SectionHeader}" Text="Verbindungsstatus"/>
                    <ItemsControl ItemsSource="{Binding Statuses}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border BorderBrush="#E2E2E2" BorderThickness="0,0,0,1" Padding="0,11">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="Eine erfolgreiche Übermittlung bedeutet, dass der Server bzw. die API die Nachricht angenommen hat. Die endgültige Postfachzustellung kann weiterhin durch nachgelagerte Richtlinien beeinflusst werden." TextWrapping="Wrap" Foreground="#777" FontSize="11" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="1,1,1,0" Margin="18,0,18,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Border Background="#F7ECEE" Padding="14,9"><Grid><TextBlock Text="Protokoll" Foreground="#681420" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Content="Clear" Command="{Binding ClearLogCommand}" Padding="12,4" Margin="0"/></Grid></Border>
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" BorderThickness="0" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Foreground="{Binding Color}" Margin="6,2"><Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"/><Run Text="  "/><Run Text="{Binding Message}"/></TextBlock></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
